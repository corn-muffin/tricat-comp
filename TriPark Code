R.<q,t> = PolynomialRing(ZZ)
Sym = SymmetricFunctions(R)

Q = QuasiSymmetricFunctions(R)
ges = Q.F()
schur = Sym.s()

"""
code to compute BPR's TriPark for r = 1
"""

def co(f):
  return f.ides_composition()
  #return f.touch_composition()

def dinv(f):
  return t^(f.dinv())

def parking_sum(P):
  b = P.upper_dyck_word()
  pf_list = b.list_parking_functions()
  tot = 0
  for f in pf_list:
    tot = tot + dinv(f)*ges(co(f))
  return tot

def r(P):
    a = P.lower_dyck_word()
    return a.number_of_touch_points()

def d(P):
  return q^(P.number_of_tamari_inversions())

def TriPark(n,k):
  TIP = TamariIntervalPosets(n)
  poly = 0
  for P in TIP:
    if r(P) == k:
      poly = poly + d(P)*parking_sum(P)
  return poly

def TriPark_full(n):
  TIP = TamariIntervalPosets(n)
  poly = 0
  for P in TIP:
      poly = poly + d(P)*parking_sum(P)
  return poly

poly = (TriPark(4,2)).to_symmetric_function()
poly = Sym(poly)
print(schur(poly))




    
    
